<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:allowBackup="false" android:label="NVR 客户端"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@drawable/ic_nvr"
        android:theme="@style/AppTheme" android:supportsRtl="true" android:usesCleartextTraffic="true">
        <service android:name=".ScreenRecordService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <activity android:name=".RecordingsActivity" android:exported="false" />
        <activity android:name=".RemoteConfigActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".MonitorActivity" android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
